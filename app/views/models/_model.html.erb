<% row_id = [model.provider, model.id].join("_").parameterize(separator: "_") %>
<%= poetry_table_row(id: "model_#{row_id}") do %>
  <%= poetry_table_cell { model.provider_class&.name || model.provider } %>
  <%= poetry_table_cell { model.name } %>
  <%= poetry_table_cell { number_with_delimiter(model.context_window) if model.context_window } %>
  <%= poetry_table_cell do %>
    <% input = model.price(:input) %>
    <% output = model.price(:output) %>
    <% if input && output %>
      $<%= "%.2f" % input %> / $<%= "%.2f" % output %>
    <% end %>
  <% end %>
  <%= poetry_table_cell do %>
    <%= poetry_link(href: new_chat_path(model: [model.provider, model.id].join(":"))) { "Start chat" } %>
  <% end %>
<% end %>

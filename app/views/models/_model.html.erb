<% row_id = [model.provider, model.id].join("_").parameterize(separator: "_") %>
<% available = ModelCatalog.available?(model) %>
<%= poetry_table_row(id: "model_#{row_id}") do %>
  <%= poetry_table_cell { model.provider_class&.display_name || model.provider } %>
  <%= poetry_table_cell { model.name } %>
  <%= poetry_table_cell { number_with_delimiter(model.context_window) if model.context_window } %>
  <%= poetry_table_cell do %>
    <% input = model.price(:input) %>
    <% output = model.price(:output) %>
    <% if input && output %>
      $<%= "%.2f" % input %> / $<%= "%.2f" % output %>
    <% end %>
  <% end %>
  <%= poetry_table_cell do %>
    <%= poetry_badge(variant: available ? :success : :secondary) do %>
      <%= available ? "Available" : "Unavailable" %>
    <% end %>
  <% end %>
  <%= poetry_table_cell do %>
    <% if available %>
      <%= poetry_link(href: new_chat_path(model: ModelCatalog.option_value(model))) { "Start chat" } %>
    <% else %>
      <span class="text-sm text-muted-foreground">Not configured</span>
    <% end %>
  <% end %>
<% end %>

<% content_for :title, "Models" %>

<div class="w-full">
  <% if notice.present? %>
    <%= poetry_alert(id: "notice") { notice } %>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Models</h1>
    <div class="flex items-center gap-2">
      <%= form_with url: refresh_models_path, method: :post do %>
        <%= poetry_button(type: :submit) { "Refresh Models" } %>
      <% end %>
    </div>
  </div>

  <div id="models" class="mt-5">
    <% if @models.any? %>
      <%= poetry_table do %>
        <%= poetry_table_header do %>
          <%= poetry_table_row do %>
            <%= poetry_table_head { "Provider" } %>
            <%= poetry_table_head { "Model" } %>
            <%= poetry_table_head { "Context Window" } %>
            <%= poetry_table_head { "$/1M tokens (In/Out)" } %>
            <%= poetry_table_head { "Status" } %>
            <%= poetry_table_head { "" } %>
          <% end %>
        <% end %>
        <%= poetry_table_body do %>
          <%= render partial: "models/model", collection: @models %>
        <% end %>
      <% end %>
    <% else %>
      <%= poetry_empty(title_tag: :h2, class: "my-10") do |empty| %>
        <% empty.with_title { "No chat models found" } %>
        <% empty.with_description { "Refresh models to fetch the latest list." } %>
      <% end %>
    <% end %>
  </div>
</div>

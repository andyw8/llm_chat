<% content_for :title, "Showing model" %>
<% available = ModelCatalog.available?(@model) %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <%= poetry_alert(id: "notice") { notice } %>
  <% end %>

  <h1 class="font-bold text-4xl">Showing model</h1>

  <div class="my-5">
    <%= poetry_metadata_list(columns: :two) do |list| %>
      <% list.with_item(label: "Provider") { @model.provider_class&.display_name || @model.provider } %>
      <% list.with_item(label: "Availability") do %>
        <%= poetry_badge(variant: available ? :success : :secondary) do %>
          <%= available ? "Available" : "Unavailable" %>
        <% end %>
      <% end %>
      <% list.with_item(label: "Model") { @model.name } %>
      <% list.with_item(label: "ID") { @model.id } %>
      <% list.with_item(label: "Context Window") { number_with_delimiter(@model.context_window) if @model.context_window } %>
      <% list.with_item(label: "Max Output Tokens") { number_with_delimiter(@model.max_output_tokens) if @model.max_output_tokens } %>
      <% if @model.capabilities.any? %>
        <% list.with_item(label: "Capabilities") do %>
          <div class="flex flex-wrap gap-2">
            <% @model.capabilities.each do |capability| %>
              <%= poetry_badge(variant: :secondary) { capability.to_s } %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if available %>
    <%= poetry_button(tag: :a, href: new_chat_path(model: ModelCatalog.option_value(@model)), variant: :secondary, class: "w-full sm:w-auto") { "Start chat with this model" } %>
  <% else %>
    <%= poetry_button(disabled: true, variant: :secondary, class: "w-full sm:w-auto") { "Start chat with this model" } %>
    <p class="mt-2 text-sm text-muted-foreground">
      Configure an API key for <%= @model.provider_class&.display_name || @model.provider %> to use this model.
    </p>
  <% end %>
  <%= poetry_button(tag: :a, href: models_path, variant: :secondary, class: "w-full sm:w-auto mt-2 sm:mt-0 sm:ml-2") { "All models" } %>
</div>

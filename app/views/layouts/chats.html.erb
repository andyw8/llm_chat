<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <div class="flex h-svh w-full overflow-hidden"
         data-controller="sidebar-a11y"
         data-sidebar-a11y-title-value="Chats"
         data-sidebar-a11y-description-value="Jump to a chat or start a new one.">
      <%= poetry_sidebar(open: cookies[:sidebar_state] != "false", collapsible: :icon) do |shell| %>
        <% shell.with_nav do %>
          <%= render "chats/sidebar", chats: @chats, current_chat: @chat %>
        <% end %>

        <% shell.with_inset do %>
          <header class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
            <%= poetry_sidebar_trigger %>
            <%= poetry_separator(orientation: :vertical, class: "h-4") %>
            <%# chat_nav keeps this label in step with the frame navigation - the
                header sits outside the frame, so the server cannot re-render it. %>
            <span class="truncate text-sm font-medium" data-chat-nav-label>
              <%= action_name == "new" ? "New chat" : "Chats" %>
            </span>
            <div class="ml-auto">
              <%= render "layouts/nav_links" %>
            </div>
          </header>

          <div class="flex min-h-0 flex-1 flex-col">
            <%= yield %>
          </div>
        <% end %>
      <% end %>
    </div>
  </body>
</html>

<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: "Tool Result Error",
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>">
    <%= poetry_message(align: :start) do |chat_message| %>
      <% chat_message.with_header { poetry_badge(variant: :secondary) { "Tool" } } %>
      <%= poetry_bubble(variant: :ghost) do %>
        <pre class="whitespace-pre-wrap text-sm overflow-x-auto"><%= tool.content.presence || "(no output)" %></pre>
      <% end %>
      <% chat_message.with_footer do %>
        <span class="text-sm"><%= local_time_tag(tool.created_at) %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= form_with(model: message, url: [@chat, message], id: "new_message", builder: Poetry::Ui::FormBuilder) do |form| %>
  <%= form.input :content,
      as: :text,
      rows: 4,
      placeholder: "Message...",
      autofocus: true,
      label: "Message" %>

  <%= form.submit "Send message" %>
<% end %>

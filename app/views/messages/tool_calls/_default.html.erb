<div id="message_tool_call_<%= tool_call.id %>">
  <%= poetry_message(align: :start) do |chat_message| %>
    <% chat_message.with_header { poetry_badge(variant: :secondary) { "Tool Call" } } %>
    <%= poetry_bubble(variant: :ghost) do %>
      <pre class="whitespace-pre-wrap text-sm overflow-x-auto"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
    <% end %>
    <% chat_message.with_footer do %>
      <span class="text-sm"><%= local_time_tag(message.created_at) %></span>
    <% end %>
  <% end %>
</div>

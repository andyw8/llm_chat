<% user ||= local_assigns[:message] %>
<div id="message_<%= user.id %>">
  <%= poetry_message(align: :end) do |message| %>
    <% message.with_header { poetry_badge(variant: :info) { "User" } } %>
    <%= poetry_bubble do %>
      <div id="message_<%= user.id %>_content" class="whitespace-pre-wrap"><%= user.content %></div>
    <% end %>
    <% message.with_footer do %>
      <div class="flex items-center gap-2">
        <span class="text-sm"><%= local_time_tag(user.created_at) %></span>
        <%= render "messages/delete", message: user %>
      </div>
    <% end %>
  <% end %>
</div>

<% assistant ||= local_assigns[:message] %>
<div id="message_<%= assistant.id %>">
  <%= poetry_message(align: :start) do |message| %>
    <% message.with_header { poetry_badge(variant: :success) { "Assistant" } } %>
    <%= poetry_bubble(variant: :secondary) do %>
      <div id="message_<%= assistant.id %>_content" class="whitespace-pre-wrap"><%= assistant.content %></div>
    <% end %>
    <% message.with_footer do %>
      <span class="text-sm"><%= assistant.created_at&.strftime("%I:%M %p") %></span>
    <% end %>
  <% end %>
</div>

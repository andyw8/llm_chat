<div id="message_<%= message.id %>">
  <%= poetry_message(align: :start) do |chat_message| %>
    <% chat_message.with_header { poetry_badge(variant: :destructive) { title.presence || "Error" } } %>
    <%= poetry_bubble(variant: :destructive) do %>
      <pre class="whitespace-pre-wrap text-sm overflow-x-auto"><%= error_message %></pre>
    <% end %>
    <% chat_message.with_footer do %>
      <span class="text-sm"><%= message.created_at&.strftime("%I:%M %p") %></span>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Chats" %>

<%= turbo_frame_tag "chat", class: "flex min-h-0 flex-1 flex-col" do %>
  <div class="flex flex-1 flex-col items-center justify-center gap-6 p-6">
    <%= poetry_empty(media_variant: :icon, title_tag: :h2) do |empty| %>
      <% empty.with_media { poetry_icon(name: :"message-square", class: "size-6") } %>
      <% empty.with_title { "No chat selected" } %>
      <% empty.with_description { "Pick a chat from the sidebar, or start a new one." } %>
    <% end %>
    <%= poetry_button(tag: :a, href: new_chat_path) { "New chat" } %>
  </div>
<% end %>

<% content_for :title, "Showing chat" %>

<%= turbo_stream_from "chat_#{@chat.id}" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <%= poetry_alert(id: "notice") { notice } %>
  <% end %>

  <h1 class="font-bold text-4xl">Showing chat #<%= @chat.id %></h1>

  <div class="my-5">
    <%= poetry_metadata_list(orientation: :horizontal) do |list| %>
      <% list.with_item(label: "Model") { @chat.model&.label || default_model_display_name } %>
    <% end %>
  </div>

  <div id="messages" class="min-w-full space-y-5 my-5">
    <% @chat.messages.each do |message| %>
      <%= render message %>
    <% end %>
  </div>

  <%= render "messages/form", chat: @chat, message: @message %>

  <%= poetry_button(tag: :a, href: chats_path, variant: :secondary, class: "w-full sm:w-auto mt-2 sm:mt-0 sm:ml-2") { "Back to chats" } %>
</div>

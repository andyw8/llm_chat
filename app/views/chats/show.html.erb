<% content_for :title, @chat.title %>

<%= turbo_stream_from "chat_#{@chat.id}" %>

<%= turbo_frame_tag "chat", class: "flex min-h-0 flex-1 flex-col" do %>
  <div class="flex shrink-0 items-center justify-between gap-4 border-b px-4 py-3">
    <div class="min-w-0">
      <h1 class="truncate text-sm font-semibold"><%= @chat.title %></h1>
      <p class="truncate text-xs text-muted-foreground"><%= @chat.model&.label || default_model_display_name %></p>
    </div>
    <%= render "chats/settings", chat: @chat, chat_models: @chat_models %>
  </div>

  <% if notice.present? %>
    <div class="px-4 pt-3"><%= poetry_alert(id: "notice") { notice } %></div>
  <% end %>

  <%= poetry_message_scroller(id: "chat-transcript", content_id: "messages", auto_scroll: true,
        default_scroll_position: :end, jump_button: true, class: "flex-1 px-4") do %>
    <%= render @messages %>
  <% end %>

  <div class="shrink-0 border-t p-4">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
<% end %>
